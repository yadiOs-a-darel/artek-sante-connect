# ═══════════════════════════════════════════
# ARTEK Connect Santé — Variables d'environnement
# Copier en .env et remplir toutes les valeurs OBLIGATOIRES
# ═══════════════════════════════════════════

# Application
APP_ENV=development
DEBUG=true
BASE_URL=http://localhost:8000

# ═══ Base de données PostgreSQL ═══
DB_PASSWORD=devpassword
DATABASE_URL=postgresql+asyncpg://artek:devpassword@localhost:5432/artek_sante

# ═══ Redis ═══
REDIS_PASSWORD=devredis
REDIS_URL=redis://:devredis@localhost:6379/0

# ═══ MongoDB ═══
MONGO_PASSWORD=devmongo
MONGODB_URL=mongodb://artek:devmongo@localhost:27017/artek_sante

# ═══ InfluxDB ═══
INFLUX_PASSWORD=devinflux
INFLUXDB_TOKEN=devtoken
INFLUXDB_ORG=artek
INFLUXDB_BUCKET=artek_iot

# ═══ JWT Sécurité ═══
JWT_SECRET_KEY=dev-secret-change-in-prod-32chars-min
JWT_ALGORITHM=HS256

# ═══ Chiffrement données médicales AES-256 ═══
MEDICAL_ENCRYPTION_KEY=devkey32byteschangeinproduction!

# ═══ Orange Money ═══
ORANGE_MERCHANT_KEY=dev_merchant_key
ORANGE_PAY_SECRET=dev_pay_secret
ORANGE_PAY_URL=https://api.orange.com/orange-money-webpay/dev/v1

# ═══ Orange SMS API ═══
ORANGE_SMS_TOKEN=dev_sms_token
ORANGE_SMS_SENDER=ARTEK

# ═══ Google Meet (visioconférence) ═══
# Option A — Production : compte de service Google Cloud + Calendar API activée
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_IMPERSONATE=medecin@votre-domaine.com

# Option B — Développement : OBLIGATOIRE pour la visio
# 1. https://meet.google.com → Nouvelle réunion → Créer une réunion
# 2. Copiez le lien (ex. abc-defg-hij) — NE PAS utiliser /new
GOOGLE_MEET_DEV_URL=https://meet.google.com/votre-code-reunion

# ═══ AWS ═══
AWS_ACCESS_KEY_ID=dev_aws_key
AWS_SECRET_ACCESS_KEY=dev_aws_secret
AWS_REGION=af-south-1
AWS_S3_BUCKET=artek-medical-images

# ═══ Firebase FCM ═══
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ═══ Monitoring ═══
SENTRY_DSN=
GRAFANA_PASSWORD=devgrafana

# ═══ MQTT Kiosques ═══
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=artek-kiosk
MQTT_PASSWORD=devmqtt

# Frontend web (sur le PC : toujours localhost)
VITE_API_URL=http://localhost:8000

# Mobile Expo (sur téléphone : IP LAN du PC, ex. 192.168.0.103)
# Le backend doit écouter sur toutes les interfaces :
#   uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
EXPO_PUBLIC_API_URL=http://192.168.0.103:8000
